# Personal admin key — full SSH access, no forced command (intentional).
# Used for manual server work: ad-hoc debugging, manual sync invocation
# (see README Step 6), editing this file, etc. Unlike the deploy/sync
# keys below, this one is not restricted to a single script/command,
# so treat it with the same care as a root-equivalent credential —
# rotate if ever suspected leaked, and don't reuse it in any CI/automation
# context where a scoped key would do.

ssh-ed25519 SECRETKEY yourEmail@gmail.com

command="cd /home/USERNAME/staging.SITENAME.org/wp-content && git pull origin main",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 SECRETKEY staging-deploy

command="cd /home/USERNAME/SITENAME.org/wp-content && git pull origin main",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 SECRETKEY prod-deploy

command="/home/USERNAME/sync-staging-db.sh",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 SECRETKEY staging-sync-deploy

# Local -> staging DB push (see push-local-db-to-staging.sh / import-local-db-to-staging-template.sh).
# Forced command reads the dump from stdin; can only ever import into staging (never prod) —
# import-local-db-to-staging.sh's own fail-closed siteurl check enforces that, this key just can't run anything else.
command="/home/USERNAME/import-local-db-to-staging.sh",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 SECRETKEY local-push-deploy